---
// K-SNAPSTEP ページ内目次(条件付き表示)
//
// 参照元: docs/KSNAPSTEP_WIREFRAME.md 8番(1日WEB担当者・月額Web担当サポート・長い記事詳細で
// 目次を設ける候補)、docs/MARORIRI_CONTENT_WIREFRAME.md 17番(記事詳細は「見出し数による自動表示」)。
// JavaScriptを使わず、ページ内アンカーリンクのみで実装する(本文が読める設計を優先)。
// スマートフォンでは<details>で開閉式にし、ページ上部を圧迫しない
// (docs/KSNAPSTEP_DESIGN_GUIDE.md 24番)。

interface TocItem {
  href: string;
  label: string;
}

interface Props {
  items: TocItem[];
  /** この件数未満なら目次自体を表示しない */
  minItems?: number;
  label?: string;
}

const { items, minItems = 3, label = "この記事の目次" } = Astro.props;
const shouldRender = items.length >= minItems;
---

{
  shouldRender && (
    <details class="toc" open>
      <summary class="toc__summary">{label}</summary>
      <nav aria-label={label}>
        <ol class="toc__list">
          {items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  )
}

<style>
  .toc {
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    padding: var(--space-s) var(--space-m);
    margin-block: var(--space-m);
  }

  .toc__summary {
    font-weight: 700;
    cursor: pointer;
    min-height: var(--tap-target-min);
    display: flex;
    align-items: center;
  }

  .toc__list {
    margin: var(--space-s) 0 0;
    padding-left: 1.25em;
  }

  .toc__list li {
    margin-bottom: 0.4em;
  }

  @media (max-width: 760px) {
    .toc {
      padding: var(--space-s);
    }
  }
</style>
