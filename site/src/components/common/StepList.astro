---
// K-SNAPSTEP 共通｜縦型ステップリスト
//
// 参照元: docs/KSNAPSTEP_WIREFRAME.md 20・21番(実施までの流れ・お問い合わせ後の流れは、
// カード化せず工程図または縦積みリストで実装し、スマートフォンでも横スクロールさせない)。
// 実際に手順・時系列であるセクションにのみ番号を使う方針(docs/KSNAPSTEP_DESIGN_GUIDE.md 16番)。

interface Step {
  title: string;
  body: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<ol class="step-list">
  {
    steps.map((step, index) => (
      <li class="step-list__item">
        <span class="step-list__num" aria-hidden="true">
          {index + 1}
        </span>
        <div class="step-list__content">
          <p class="step-list__title">{step.title}</p>
          <p class="step-list__body">{step.body}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .step-list {
    margin: var(--space-m) 0;
    padding: 0;
    list-style: none;
  }

  .step-list__item {
    display: flex;
    gap: var(--space-s);
    padding-block: var(--space-s);
    border-top: 1px solid var(--color-border);
  }

  .step-list__item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .step-list__num {
    flex-shrink: 0;
    width: 2em;
    height: 2em;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    font-weight: 700;
  }

  .step-list__title {
    margin: 0 0 0.25em;
    font-weight: 700;
  }

  .step-list__body {
    margin: 0;
    color: var(--color-text);
  }
</style>
