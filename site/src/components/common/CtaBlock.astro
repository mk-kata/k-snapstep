---
// K-SNAPSTEP 汎用CTAコンポーネント
//
// 全ページへ同じ問い合わせCTAを機械的に表示しない方針(docs/KSNAPSTEP_WIREFRAME.md 7番)。
// 今回はコンポーネントの作成のみ行い、各ページへの大量配置は行わない。
//
// 【2026年8月5日】狭い幅で見出しが意味の切れ目でない位置に折り返すのを防ぐため、
// headingをHTML(set:html)として描画するよう変更した。呼び出し側は各ページの静的な
// 確定文言のみを渡しており、外部入力は扱わないためXSSの懸念はない。改行が必要な箇所には
// <br class="heading-break" />(狭い幅のみ有効)を埋め込む。

interface Props {
  /** 小さなラベル(任意) */
  label?: string;
  /** 見出し。静的な確定文言のみを渡すこと(set:htmlで描画するため) */
  heading: string;
  body?: string;
  buttonLabel: string;
  url: string;
  variant?: "primary" | "quiet" | "reading";
  secondaryLinkLabel?: string;
  secondaryLinkUrl?: string;
  /** 主ボタンへ付与する data-cta 属性値(任意。計測用の安定した識別子、docs/KSNAPSTEP_LAUNCH_FOUNDATION.md 10番) */
  ctaId?: string;
  /**
   * 見出しのタグ名。ページ内の独立したセクション見出しとして使う場合は"h2"を指定する
   * (docs/KSNAPSTEP_HOME_IMPLEMENTATION.md セクション9で使用)。
   * 既定は"p"(他の要素内の一部として使う場合、見出し階層に影響を与えない)。
   */
  headingLevel?: "h2" | "h3" | "p";
}

const {
  label,
  heading,
  body,
  buttonLabel,
  url,
  variant = "primary",
  secondaryLinkLabel,
  secondaryLinkUrl,
  headingLevel = "p",
  ctaId,
} = Astro.props;

const HeadingTag = headingLevel;
---

<div class={`cta-block cta-block--${variant}`}>
  {label && <p class="cta-block__label">{label}</p>}
  <HeadingTag class="cta-block__heading" set:html={heading} />
  {body && <p class="cta-block__body">{body}</p>}
  <a class={variant === "quiet" ? "btn-ghost" : "btn-primary"} href={url} data-cta={ctaId}>
    {buttonLabel}
  </a>
  {
    secondaryLinkLabel && secondaryLinkUrl && (
      <a class="cta-block__secondary-link" href={secondaryLinkUrl}>
        {secondaryLinkLabel}
      </a>
    )
  }
</div>
