---
// K-SNAPSTEP 共通料金表(2列)
//
// 参照元: docs/KSNAPSTEP_DESIGN_GUIDE.md 18・19番(料金はカードではなく表形式(2列)で統一)。

interface Row {
  label: string;
  value: string;
}

interface Props {
  rows: Row[];
  caption?: string;
}

const { rows, caption } = Astro.props;
---

<table class="price-table">
  {caption && <caption class="price-table__caption">{caption}</caption>}
  <tbody>
    {
      rows.map((row) => (
        <tr>
          <th scope="row">{row.label}</th>
          <td>{row.value}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .price-table {
    width: 100%;
    border-collapse: collapse;
    margin-block: var(--space-m);
  }

  .price-table__caption {
    text-align: left;
    font-weight: 700;
    margin-bottom: 0.5em;
  }

  .price-table th,
  .price-table td {
    text-align: left;
    padding: 0.75em 1em;
    border-top: 1px solid var(--color-border);
    vertical-align: top;
  }

  .price-table th {
    width: 40%;
    font-weight: 700;
    color: var(--color-heading);
    background: var(--color-bg-alt);
  }

  .price-table tr:last-child th,
  .price-table tr:last-child td {
    border-bottom: 1px solid var(--color-border);
  }

  @media (max-width: 760px) {
    .price-table,
    .price-table tbody,
    .price-table tr,
    .price-table th,
    .price-table td {
      display: block;
      width: auto;
    }

    .price-table tr {
      padding-block: 0.5em;
    }

    .price-table th {
      border-bottom: none;
      padding-bottom: 0.25em;
    }

    .price-table td {
      border-top: none;
      padding-top: 0;
    }
  }
</style>
