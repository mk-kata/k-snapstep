---
// トップページ セクション5｜このようなテーマを扱います(相談テーマ例)
//
// 出典: docs/MARORIRI_SITE_SPEC.md 407〜426行目(15-1 セクション5、確定本文)。
// CTA文言・リンク先も同424行目の確定内容(「1日WEB担当者で相談できることを見る」)をそのまま使用。
// MARORIRIというブランド名の言及はなく、変更せずそのまま使用している。
// 詳細な出典・分類は docs/KSNAPSTEP_HOME_COPY_AUDIT.md 4番を参照。
//
// 【2026年7月28日 デザイン実装】承認デザイン画像に合わせ、アイコン付きの薄枠ボックス6件へ変更した。
// 項目文・CTA文言・リンク先は変更していない。
// 【2026年7月29日】ユーザーから提供されたイラスト調アイコン画像
// へ差し替えた。公式ブランドロゴ画像(WordPress社等の商標)は使用しておらず、
// 移行イメージを表す一般的な線画イラスト(topic-migrate)を使用している。
// 【2026年7月31日】画像を正規化済みアイコン(normalized/)へ切り替えた。
// 【2026年8月5日(1)】本番公開準備として、未使用の元画像(normalized化前の18個)を
// docs/home-icons-source/ へ移動した(publicから外し、本番ビルドに含めないため)。
// 【2026年8月5日(2)】ユーザー指示により、見出し・英字アイキャッチ・導入文を追加した。
// 【2026年8月5日(3)】ユーザー指示により、6項目の文言をより簡潔な表現へ整えた
// (意味は変えず、箇条書きらしい体言止めに統一)。
import { urls } from "../../config/site";

const topics = [
  { icon: "topic-site-issue", text: "サイトの問題点と改修の優先順位" },
  { icon: "topic-shop-mail", text: "制作会社の選定と見積もり・<br />提案内容の比較" },
  { icon: "topic-migrate", text: "WordPress・Movable Typeの<br />運用方針の整理" },
  { icon: "topic-ec", text: "ECサイトや複数の販売環境の整理" },
  { icon: "topic-server-domain", text: "サーバー・ドメイン・メールの<br />管理状況確認" },
  { icon: "topic-seo-analytics", text: "SEO・アクセス解析をもとにした<br />改善点の整理" },
];
---

<section class="topics">
  <div class="container">
    <p class="section-eyebrow section-eyebrow--center">CONSULTATION</p>
    <h2 class="section-heading section-heading--center">
      こんなWebの悩みを<br class="heading-break" />一緒に整理します
    </h2>
    <p class="topics__intro">
      サイト改善や制作会社とのやり取り、<br class="heading-break-xs" />
      CMS・サーバー管理など、<br />
      社内だけでは判断しにくい内容をご相談いただけます。
    </p>

    <ul class="topics__grid">
      {
        topics.map((topic) => (
          <li class="topics__item">
            <span class="topics__icon" aria-hidden="true">
              <img src={`/images/home/icons/normalized/${topic.icon}.webp`} alt="" loading="lazy" decoding="async" />
            </span>
            <p set:html={topic.text} />
          </li>
        ))
      }
    </ul>

    <p class="topics__link">
      <a href={urls.oneDayWebManager}>1日WEB担当者で相談できることを見る</a>
    </p>
  </div>
</section>
