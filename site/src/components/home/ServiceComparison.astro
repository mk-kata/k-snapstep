---
// トップページ セクション4｜単発と継続、2つの関わり方(1日WEB担当者・月額Web担当サポート)
//
// 出典: docs/KSNAPSTEP_SITE_SPEC.md 10番セクション4の見出し、および同7番「サービス一覧」の確定事実
// (料金・回数・時間・含まれる内容)をそのまま使用。要約・言い換えは行っていない。
// 上位/下位プランに見せないよう、2枚を同格のブロックとして扱う。
import { urls } from "../../config/site";
---

<section class="service-comparison">
  <div class="container">
    <h2 class="section-heading">単発と継続、2つの関わり方</h2>
    <p class="service-comparison__note">上位・下位の関係ではありません</p>

    <div class="service-comparison__grid">
      <article class="service-comparison__card">
        <p class="service-comparison__label">単発</p>
        <h3 class="service-comparison__title">1日WEB担当者</h3>
        <p class="service-comparison__price">
          <span class="service-comparison__price-amount">55,000円（税込）</span>
          <span class="service-comparison__price-unit">/ 1回</span>
        </p>
        <ul class="service-comparison__facts">
          <li>1テーマ・1サイト</li>
          <li>全国オンライン対応</li>
          <li>WEB担当者メモ + テーマに応じた資料1点</li>
          <li>実施後のフォロー</li>
        </ul>
        <a class="btn-ghost" href={urls.oneDayWebManager}>1日WEB担当者を見る</a>
      </article>

      <article class="service-comparison__card">
        <p class="service-comparison__label">継続</p>
        <h3 class="service-comparison__title">月額Web担当サポート</h3>
        <p class="service-comparison__price">
          <span class="service-comparison__price-amount">月額55,000円（税込）</span>
          <span class="service-comparison__price-unit">/ 月</span>
        </p>
        <ul class="service-comparison__facts">
          <li>月2回・各60分のオンライン面談</li>
          <li>判断と進行を継続的に確認</li>
          <li>実作業は別途見積もり</li>
        </ul>
        <a class="btn-ghost" href={urls.monthlySupport}>月額サポートを見る</a>
      </article>
    </div>
  </div>
</section>
