---
// トップページ デザイン実装用｜共通線画アイコン
//
// 出典: docs/KSNAPSTEP_TOP_DESIGN_REFERENCE.png(承認済みデザイン画像)の指示に基づき、
// 外部アイコンCDN・アイコンフォントは使用せず、すべて自作のインラインSVG(線画・currentColor)
// として実装した。ブランドロゴ(WordPress等)は使用せず、内容を表す一般的な線画のみを使う。
// 装飾用途のため、常に aria-hidden="true" を付与する。
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = "" } = Astro.props;
---

<svg
  class={`icon ${className}`}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "search" && (
    <g>
      <circle cx="10.5" cy="10.5" r="6.5" />
      <line x1="20" y1="20" x2="15.4" y2="15.4" />
    </g>
  )}
  {name === "split" && (
    <g>
      <path d="M12 4v5M12 9L6 13M12 9l6 4" />
      <circle cx="6" cy="16" r="2.4" />
      <circle cx="18" cy="16" r="2.4" />
    </g>
  )}
  {name === "file-check" && (
    <g>
      <path d="M6 3h9l3 3v15H6z" />
      <polyline points="9,13 11,15 15,10" />
    </g>
  )}
  {name === "toggle" && (
    <g>
      <rect x="3" y="8" width="18" height="8" rx="4" />
      <circle cx="8.5" cy="12" r="2.6" />
    </g>
  )}
  {name === "users" && (
    <g>
      <circle cx="8.5" cy="8.5" r="3" />
      <path d="M3.5 20c0-3.5 2.4-6 5-6s5 2.5 5 6" />
      <circle cx="17" cy="9.3" r="2.2" />
      <path d="M14.7 20c.3-2.6 1.7-4.4 3.6-4.7" />
    </g>
  )}
  {name === "flag" && (
    <g>
      <line x1="5" y1="3" x2="5" y2="21" />
      <path d="M5 4h11l-3 4 3 4H5z" />
    </g>
  )}
  {name === "question" && (
    <g>
      <circle cx="12" cy="12" r="9" />
      <path d="M9.3 9.6a2.7 2.7 0 1 1 3.9 2.4c-.9.5-1.2 1-1.2 2" />
      <circle cx="12" cy="17" r="0.4" fill="currentColor" stroke="none" />
    </g>
  )}
  {name === "monitor-question" && (
    <g>
      <rect x="3" y="4" width="18" height="12" rx="1.2" />
      <line x1="8" y1="20" x2="16" y2="20" />
      <line x1="12" y1="16" x2="12" y2="20" />
      <path d="M10.4 8.7a1.9 1.9 0 1 1 2.7 1.7c-.6.3-.8.7-.8 1.3" />
      <circle cx="12" cy="13.6" r="0.35" fill="currentColor" stroke="none" />
    </g>
  )}
  {name === "database-swap" && (
    <g>
      <ellipse cx="12" cy="6" rx="7" ry="2.6" />
      <path d="M5 6v5.5c0 1.4 3.1 2.6 7 2.6s7-1.2 7-2.6V6" />
      <path d="M5 11.5V17c0 1.4 3.1 2.6 7 2.6s7-1.2 7-2.6v-5.5" />
    </g>
  )}
  {name === "server" && (
    <g>
      <rect x="4" y="4" width="16" height="6" rx="1" />
      <rect x="4" y="14" width="16" height="6" rx="1" />
      <circle cx="7.5" cy="7" r="0.5" fill="currentColor" stroke="none" />
      <circle cx="7.5" cy="17" r="0.5" fill="currentColor" stroke="none" />
    </g>
  )}
  {name === "search-check" && (
    <g>
      <circle cx="10.5" cy="10.5" r="6.5" />
      <polyline points="7.6,10.6 9.7,12.7 13.6,8" />
      <line x1="20" y1="20" x2="15.4" y2="15.4" />
    </g>
  )}
  {name === "user-alone" && (
    <g>
      <circle cx="11" cy="8" r="3.4" />
      <path d="M4.5 20c0-4.1 2.9-7.2 6.5-7.2s6.5 3.1 6.5 7.2" />
      <line x1="18.5" y1="4" x2="18.5" y2="8" />
      <circle cx="18.5" cy="10.6" r="0.4" fill="currentColor" stroke="none" />
    </g>
  )}
  {name === "calendar" && (
    <g>
      <rect x="3" y="5" width="18" height="16" rx="1.2" />
      <line x1="3" y1="10" x2="21" y2="10" />
      <line x1="8" y1="3" x2="8" y2="7" />
      <line x1="16" y1="3" x2="16" y2="7" />
      <circle cx="8.5" cy="15" r="1.1" fill="currentColor" stroke="none" />
    </g>
  )}
  {name === "repeat" && (
    <g>
      <path d="M4.5 12a7.5 7.5 0 0 1 12.6-5.5" />
      <path d="M17.1 3.5v4h-4" />
      <path d="M19.5 12a7.5 7.5 0 0 1-12.6 5.5" />
      <path d="M6.9 20.5v-4h4" />
    </g>
  )}
  {name === "target" && (
    <g>
      <circle cx="12" cy="12" r="8" />
      <circle cx="12" cy="12" r="4.3" />
      <circle cx="12" cy="12" r="0.6" fill="currentColor" stroke="none" />
    </g>
  )}
  {name === "scale" && (
    <g>
      <line x1="12" y1="3" x2="12" y2="21" />
      <line x1="5" y1="7" x2="19" y2="7" />
      <path d="M5 7l-3.2 6.2a3.2 3.2 0 0 0 6.4 0z" />
      <path d="M19 7l-3.2 6.2a3.2 3.2 0 0 0 6.4 0z" />
      <line x1="8" y1="21" x2="16" y2="21" />
    </g>
  )}
  {name === "layers" && (
    <g>
      <polygon points="12,4 21,9 12,14 3,9" />
      <polyline points="3,14 12,19 21,14" />
    </g>
  )}
  {name === "cart" && (
    <g>
      <circle cx="9.5" cy="20" r="1.2" fill="currentColor" stroke="none" />
      <circle cx="17" cy="20" r="1.2" fill="currentColor" stroke="none" />
      <path d="M3 4h2.2l2.2 11.2a2 2 0 0 0 2 1.6h7.4a2 2 0 0 0 2-1.6L21 8H6.4" />
    </g>
  )}
  {name === "trending-up" && (
    <g>
      <polyline points="4,17 10,11 14,14 20,6" />
      <polyline points="14,6 20,6 20,12" />
    </g>
  )}
  {name === "mail" && (
    <g>
      <rect x="3" y="5" width="18" height="14" rx="1.4" />
      <path d="M3 6.5l9 6.5 9-6.5" />
    </g>
  )}
  {name === "chat" && (
    <g>
      <path d="M4 5.5h16a1 1 0 0 1 1 1V15a1 1 0 0 1-1 1H9.5L5 20v-4H4a1 1 0 0 1-1-1V6.5a1 1 0 0 1 1-1z" />
    </g>
  )}
  {name === "check-circle" && (
    <g>
      <circle cx="12" cy="12" r="9" />
      <polyline points="8,12.5 10.6,15 16,8.6" />
    </g>
  )}
  {name === "pie-chart" && (
    <g>
      <circle cx="12" cy="12" r="8" />
      <path d="M12 12V4A8 8 0 0 1 19.3 16.4L12 12Z" />
    </g>
  )}
  {name === "bar-chart" && (
    <g>
      <line x1="5" y1="20" x2="19" y2="20" />
      <rect x="5.5" y="12.5" width="3" height="7" />
      <rect x="10.5" y="8.5" width="3" height="11" />
      <rect x="15.5" y="4.5" width="3" height="15" />
    </g>
  )}
  {name === "browser-gear" && (
    <g>
      <rect x="3" y="4" width="18" height="16" rx="1.4" />
      <line x1="3" y1="8" x2="21" y2="8" />
      <circle cx="6.2" cy="6" r="0.5" fill="currentColor" stroke="none" />
      <circle cx="9" cy="6" r="0.5" fill="currentColor" stroke="none" />
      <circle cx="14.5" cy="14" r="2.4" />
      <line x1="14.5" y1="9.8" x2="14.5" y2="11.2" />
      <line x1="14.5" y1="16.8" x2="14.5" y2="18.2" />
      <line x1="10.3" y1="14" x2="11.7" y2="14" />
      <line x1="17.3" y1="14" x2="18.7" y2="14" />
    </g>
  )}
  {name === "plant" && (
    <g>
      <path d="M12 21v-9" />
      <path d="M12 12c0-3.5-2.5-5.5-5.5-5.5C6.8 10 9 12.3 12 12z" />
      <path d="M12 14c0-3.5 2.5-5.5 5.5-5.5C17.2 12 15 14.3 12 14z" />
      <path d="M8 21h8" />
    </g>
  )}
</svg>
