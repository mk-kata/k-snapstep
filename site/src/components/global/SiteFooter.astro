---
// K-SNAPSTEP 共通フッター
//
// 参照元: docs/KSNAPSTEP_WIREFRAME.md 5番
// - 外部リンクであることが分かる表記を付ける(docs/KSNAPSTEP_DESIGN_GUIDE.md 17・23番)
// - note・ココナラ・本来面目noteへのリンクは今回含めない
//
// 【2026年8月5日(1)】ユーザー提供のレイアウト参考画像(2カラム構成)に合わせ、
// 3カラム(主要ページ/読みもの/法務等)を2カラム(サービス/サイト情報)へ整理した。
// 参考画像にあったSNSアイコン・会社概要・特定商取引法表記は、実際のアカウント/ページが
// 存在しないため追加していない(架空のリンクを作らない方針)。
// 【2026年8月5日(2)】ユーザー指示により、MARORIRIリンクを独立した1行から
// 「サイト情報」ナビ内の項目へ移動した(元は主要ページと同列に置かない方針だったが、
// 今回の指示で変更)。
// 【2026年8月5日(3)】ユーザー指示により、2カラム(サービス/サイト情報)から
// 4カラム(サービス/片山まゆみについて/サイト情報/関連リンク)へ再構成した。
// 「月額Web担当サポート」の表示ラベルをこのナビ内のみ「継続Web担当サポート」に変更。

import { site, urls, maroriri, copyright } from "../../config/site";
---

<footer class="site-footer">
  <div class="site-footer__inner container">
    <div class="site-footer__brand">
      <p class="site-footer__name">{site.name}</p>
      <p class="site-footer__tagline">{site.tagline}</p>
    </div>

    <nav class="site-footer__nav" aria-label="フッターナビゲーション">
      <div class="site-footer__nav-group">
        <p class="site-footer__nav-heading">サービス</p>
        <ul>
          <li><a href={urls.oneDayWebManager}>1日WEB担当者</a></li>
          <li><a href={urls.monthlySupport}>継続Web担当サポート</a></li>
          <li><a href={urls.services}>対応できること</a></li>
        </ul>
      </div>

      <div class="site-footer__nav-group">
        <p class="site-footer__nav-heading">片山まゆみについて</p>
        <ul>
          <li><a href={urls.profile}>片山まゆみについて</a></li>
          <li><a href={urls.reading}>読みもの一覧</a></li>
        </ul>
      </div>

      <div class="site-footer__nav-group">
        <p class="site-footer__nav-heading">サイト情報</p>
        <ul>
          <li><a href={urls.contact}>お問い合わせ</a></li>
          <li><a href={urls.privacy}>プライバシーポリシー</a></li>
        </ul>
      </div>

      <div class="site-footer__nav-group">
        <p class="site-footer__nav-heading">関連リンク</p>
        <ul>
          <li>
            <a href={maroriri.url} rel="noopener" target="_blank">
              コーダー・Web制作者向けの活動 MARORIRI<span class="external-link-indicator" aria-hidden="true">↗</span
              ><span class="visually-hidden">(外部サイト)</span>
            </a>
          </li>
        </ul>
      </div>
    </nav>

    <div class="site-footer__bottom">
      <p class="site-footer__copyright">{copyright}</p>
      <a class="site-footer__totop" href="#top">
        ページトップへ<span aria-hidden="true"> ↑</span>
      </a>
    </div>
  </div>
</footer>
