---
// 読みもの一覧
//
// 参照元: docs/KSNAPSTEP_SITE_SPEC.md 16番・docs/KSNAPSTEP_WIREFRAME.md 15番・
// docs/MARORIRI_CONTENT_WIREFRAME.md 3番。
// 公開初期は「小さな会社のホームページ見直しノート」1シリーズのみで運用する構成とし、
// 旧資料(3番)にあった2シリーズ左右比較のレイアウトはそのまま使用しない
// (docs/KSNAPSTEP_WIREFRAME.md 15番の指示どおり)。
// draft: true の記事は一覧に表示しない(docs/KSNAPSTEP_IMPLEMENTATION_GAP.md 14番)。
// 見出し・導入文は確定資料に本文が見当たらなかったため、今回新規作成した(新規本文案)。
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/navigation/Breadcrumbs.astro";
import BreadcrumbJsonLd from "../../components/seo/BreadcrumbJsonLd.astro";
import PageHeader from "../../components/page/PageHeader.astro";
import ArticleCard from "../../components/reading/ArticleCard.astro";
import { getCollection } from "astro:content";
import { urls } from "../../config/site";

const breadcrumbItems = [{ label: "トップ", href: "/" }, { label: "読みもの" }];

const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const websiteReviewArticles = allArticles
  .filter((article) => article.data.series === "website-review")
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());
const latestArticles = websiteReviewArticles.slice(0, 3);
---

<BaseLayout
  title="読みもの"
  description="小さな会社や事業者が、自社のホームページや制作体制を見直すための読みもの一覧です。"
  layoutType="page"
  showBuildNotice={false}
>
  <div class="container content-width">
    <Breadcrumbs items={breadcrumbItems} />
    <BreadcrumbJsonLd items={breadcrumbItems} currentPath={Astro.url.pathname} />

    <PageHeader
      heading="Webを、<br class='heading-break' />自分たちで判断する<br class='heading-break-xs' />ための読みもの。"
      intro="小さな会社や事業者が、ホームページや制作会社とのやり取りについて考えるための読みものです。今後、テーマが増えた段階で、シリーズを追加していく予定です。"
    />

    <section class="section-block">
      <h2>小さな会社の<br class="heading-break" />ホームページ見直しノート</h2>
      <p>
        ホームページの見直し、制作会社とのやり取り、CMS・更新、サーバー・ドメイン、SEO・アクセス解析など、専任のWeb担当者がいない会社や事業者が、自社のWebサイトや制作体制を判断するための読みものです。技術者向けのコード解説ブログではありません。
      </p>
      <a class="btn-ghost" href={urls.reading + "website-review/"}>シリーズをすべて見る</a>
    </section>

    <section class="section-block">
      <h2>最新記事</h2>
      {
        latestArticles.length === 0 ? (
          <p>現在、公開中の記事はありません。</p>
        ) : (
          <div class="article-list">
            {latestArticles.map((article) => (
              <ArticleCard
                href={`${urls.reading}website-review/${article.data.slug ?? article.id}/`}
                title={article.data.title}
                description={article.data.description}
                publishedDate={article.data.publishedDate}
                seriesLabel="小さな会社のホームページ見直しノート"
              />
            ))}
          </div>
        )
      }
    </section>

    <p class="quiet-links">
      関連ページ： <a href={urls.oneDayWebManager}>1日WEB担当者</a> ／ <a href={urls.services}>対応できること</a>
    </p>
  </div>
</BaseLayout>

<style>
  .article-list {
    margin-top: var(--space-s);
  }

  .quiet-links {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    padding-block: var(--space-m);
    border-top: 1px solid var(--color-border);
  }
</style>
