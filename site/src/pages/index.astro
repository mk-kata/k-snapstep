---
// K-SNAPSTEP トップページ
//
// 確定9セクション構成(docs/KSNAPSTEP_SITE_SPEC.md 10番・docs/KSNAPSTEP_WIREFRAME.md 9番)。
// 旧セクション9「マロリリコーダー部」・旧「本来面目らぼ」・占い関連の内容は含めていない。
// MARORIRIへの導線は、共通フッターの補助リンクのみ(トップページ本文には設置しない)。
//
// 各セクションの確定本文の出典・未確定箇所は、各コンポーネント冒頭のコメントを参照。
// セクション2・5・6・7・8・9は、docs/KSNAPSTEP_HOME_COPY_AUDIT.mdの調査により
// docs/MARORIRI_SITE_SPEC.md 15-1(旧トップページ確定本文)から採用している。
// 全体の状況は docs/KSNAPSTEP_HOME_IMPLEMENTATION.md にまとめている。
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/home/HeroSection.astro";
import ConcernsSection from "../components/home/ConcernsSection.astro";
import RoleSection from "../components/home/RoleSection.astro";
import ServiceComparison from "../components/home/ServiceComparison.astro";
import TopicsSection from "../components/home/TopicsSection.astro";
import ExperienceSection from "../components/home/ExperienceSection.astro";
import WorkSupportSection from "../components/home/WorkSupportSection.astro";
import ProfileSummary from "../components/home/ProfileSummary.astro";
import CtaBlock from "../components/common/CtaBlock.astro";
import "../styles/home.css";
import { site, urls } from "../config/site";
---

<BaseLayout
  title={site.name}
  description={site.defaultDescription}
  layoutType="home"
  showBuildNotice={false}
>
  <HeroSection />
  <ConcernsSection />
  <RoleSection />
  <ServiceComparison />
  <TopicsSection />
  <ExperienceSection />
  <WorkSupportSection />
  <ProfileSummary />

  <div class="home-final-cta section--decorated">
    <div class="container">
      <!--
        セクション9｜お問い合わせ(旧セクション10)
        出典: docs/MARORIRI_SITE_SPEC.md 499〜513行目(15-1 セクション10、確定本文)。
        docs/KSNAPSTEP_HOME_COPY_AUDIT.mdの調査範囲(セクション2・5・6・7・8)外だが、
        同一資料を確認する過程で本セクションの確定本文も発見したため、あわせて差し替えた
        (docs/KSNAPSTEP_HOME_COPY_AUDIT.md 8・13番参照)。MARORIRIの言及なし。
        見出し・CTAは docs/KSNAPSTEP_WIREFRAME.md 9番セクション9とも一致。

        【2026年7月28日 デザイン実装】承認デザイン画像に合わせ、えんじ色の横長CTA帯として
        表示するため .home-final-cta でラップし、home.css側でこの範囲だけ配色を上書きしている。
        共通コンポーネント CtaBlock 自体・他ページでの見た目は変更していない。
        見出し・本文・ボタン文言・リンク先は変更していない。
      -->
      <CtaBlock
        heading="何を頼めばよいか分からない段階でも、ご相談ください。"
        body="まだ依頼する内容が決まっていなくても構いません。今困っていることをお送りください。内容を確認したうえで、1日WEB担当者と月額サポート、どちらが合うかも含めてご案内します。基本はオンラインでの相談です。内容や地域によっては、訪問での対応も可能です。"
        buttonLabel="今の状況を相談する"
        url={urls.contact}
        variant="primary"
        headingLevel="h2"
        ctaId="home-contact-cta"
      />
    </div>
  </div>
</BaseLayout>
