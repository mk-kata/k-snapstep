---
// お問い合わせ
//
// 出典: docs/KSNAPSTEP_SITE_SPEC.md 15番のとおり、docs/MARORIRI_SITE_SPEC.md 15-7
// (1672〜1823行目、全7セクション+フォーム項目一覧)を確認した。「お問い合わせの種類」の
// 選択肢のみをSITE_SPEC 15番の確定8択(マロリリコーダー部を除外し、Webサイト・CMSと
// 制作会社とのやり取りを2項目に分割した版)へ差し替え、他セクションは
// 「MARORIRIが」→「K-SNAPSTEPが」等のブランド名変更のみで使用している。
//
// formrunを実装した(docs/KSNAPSTEP_LAUNCH_FOUNDATION.md 6・7番)。
// - フォーム識別情報(data-formrun-form)・送信先は、既存の正式実装元(labo/index.html)から
//   確認した値をそのまま使用し、変更していない(site/src/config/site.tsの`formrun`定数に集約)。
// - 新しいフォームは作成していない。既存のformrun管理画面上の1つのフォームをそのまま利用する。
// - 埋め込みスクリプト(https://sdk.form.run/js/v2/embed.js)は、このページでのみ1回だけ読み込む
//   (BaseLayoutなど共通レイアウトには含めていないため、他ページでの重複読込は発生しない)。
// - 実際にformrun側で現在設定されている項目(お問い合わせの種類の選択肢等)は、ローカルの
//   コードからは確認できない(embedスクリプトが実行時にformrunのサーバーから取得して描画するため)。
//   このページの本文(6番セクション「フォームに入力していただく内容」等)で説明している内容と、
//   formrun管理画面側の実際の設定が一致しているかは未確認。矛盾の可能性は
//   docs/KSNAPSTEP_LAUNCH_FOUNDATION.md 6・8番に記録している。
// - PUBLIC_ENABLE_FORM=false の場合のみ、実際の埋め込みを行わず代替文言を表示する
//   (ステージング等で誤って実際の問い合わせを送信させないための切り替え)。
// - スクリプト読み込み失敗時・JavaScript無効時の案内をそれぞれ用意した。
// - 一般利用者向けには「未完成」「構築中」等の表示をしていない。
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/navigation/Breadcrumbs.astro";
import BreadcrumbJsonLd from "../../components/seo/BreadcrumbJsonLd.astro";
import PageHeader from "../../components/page/PageHeader.astro";
import StepList from "../../components/common/StepList.astro";
import Icon from "../../components/icons/Icon.astro";
import { urls, formrun } from "../../config/site";

const breadcrumbItems = [{ label: "トップ", href: "/" }, { label: "お問い合わせ" }];

const consultItems = [
  { icon: "toggle", text: "今のサイトを活かして改善するのか、作り直すのか迷っている" },
  { icon: "chat", text: "制作会社への頼み方や見積もりを確認したい" },
  { icon: "server", text: "CMSやサーバーの管理状況が分からない" },
  { icon: "search-check", text: "修正内容が意図どおり反映されているか確認したい" },
  { icon: "repeat", text: "継続してWebの判断や進行を確認してほしい" },
  { icon: "question", text: "K-SNAPSTEPで実作業に対応できるか確認したい" },
];

const afterSteps = [
  { title: "フォームから送信", body: "フォームから、現在の状況をお送りください。" },
  { title: "内容確認", body: "K-SNAPSTEPが内容を確認します。" },
  { title: "追加確認(必要な場合)", body: "必要に応じて、追加の情報を確認します。" },
  { title: "ご案内", body: "適した相談方法や、進め方をご案内します。" },
];
---

<BaseLayout
  title="お問い合わせ"
  description="まとまっていなくても、今の状況をお送りください。サービスを決めていなくても構いません。内容を確認し、K-SNAPSTEPから適した進め方をご案内します。"
  layoutType="page"
  showBuildNotice={false}
>
  <div class="container content-width">
    <Breadcrumbs items={breadcrumbItems} />
    <BreadcrumbJsonLd items={breadcrumbItems} currentPath={Astro.url.pathname} />

    <PageHeader
      heading="まとまっていなくても、<br class='heading-break' />今の状況を<br class='heading-break-xs' />お送りください。"
      intro="サービスを決めていなくても構いません。今のWebに関する状況や、困っていることを分かる範囲でお送りください。内容を確認し、K-SNAPSTEPから適した進め方をご案内します。お問い合わせのみで契約が成立することはありません。"
      ctaLabel="お問い合わせ内容を入力する"
      ctaHref="#form"
      ctaId="contact-page-jump-to-form"
    />

    <section class="section-block">
      <h2>このような内容を<br class="heading-break" />ご相談いただけます。</h2>
      <ul class="concern-cards">
        {
          consultItems.map((item) => (
            <li class="concern-cards__item">
              <span class="concern-cards__icon" aria-hidden="true">
                <Icon name={item.icon} />
              </span>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section-block">
      <h2>サービスを決めていなくても<br class="heading-break" />構いません。</h2>
      <p>
        一つの課題を集中して整理する場合は、1日WEB担当者が合います。継続してWebの判断や進行を確認する場合は、Web担当者サポートが合います。実作業が必要な場合は、内容を確認したうえで個別にお見積もりします。
      </p>
      <p>
        どれが合うか分からなくても、ご自身でサービスを決めてからお問い合わせいただく必要はありません。お送りいただいた内容を確認したうえで、進め方をご案内します。
      </p>
      <p class="quiet-links">
        <a href={urls.oneDayWebManager}>1日WEB担当者</a> ／
        <a href={urls.monthlySupport}>Web担当者サポート</a> ／
        <a href={urls.services}>対応できること</a>
      </p>
    </section>

    <section class="section-block">
      <h2>お問い合わせ後の流れ。</h2>
      <StepList steps={afterSteps} />
    </section>

    <section class="section-block">
      <h2>フォームに<br class="heading-break" />入力していただく内容。</h2>
      <p>
        お名前、メールアドレス、お問い合わせの種類、現在困っていることをご記入ください。会社名・屋号は任意ですので、個人でご相談の場合は空欄で構いません。
      </p>
      <p>
        対象サイトのURL、使用中のCMS・ECサービス、制作会社の有無、希望する対応時期は、分かる範囲でご記入ください。URLやCMSが分からない場合も、空欄のままで大丈夫です。
      </p>
    </section>

    <section class="section-block">
      <h2>オンラインと訪問について。</h2>
      <p>
        ご相談は、基本的にオンラインで行います。内容や地域によっては、訪問での対応も可能です。訪問をご希望の場合は、フォームの「オンライン・訪問の希望」でお知らせください。
      </p>
    </section>

    <section id="form" class="section-block">
      <h2>現在の状況をお送りください。</h2>
      <p>
        すべてを整理して書く必要はありません。現在困っていることを、分かる範囲でご記入ください。サイトのURLや使用中のCMSなど、任意の項目は、分からなければ空欄で構いません。内容を確認したうえで、進め方をご案内します。
      </p>

      <p class="privacy-note">
        送信いただく内容は、<a href={urls.privacy}>プライバシーポリシー</a>に基づき取り扱います。
      </p>

      {
        formrun.enabled ? (
          <div class="formrun-wrap" data-form-area="formrun">
            <p id="formrun-load-error" class="formrun-fallback" hidden>
              フォームの読み込みに問題が発生しました。時間をおいてページを再読み込みしていただくか、解決しない場合はお手数ですが後ほど改めてお試しください。
            </p>
            <noscript>
              <p class="formrun-fallback">
                お使いのブラウザでJavaScriptが無効になっているため、フォームを表示できません。JavaScriptを有効にしてページを再読み込みしてください。
              </p>
            </noscript>
            <div
              class="formrun-embed"
              data-cta="formrun-embed"
              data-formrun-form={formrun.formId}
              data-formrun-redirect={String(formrun.redirect)}
            />
          </div>
        ) : (
          <p class="formrun-fallback">
            現在、このフォームは表示していません。時間をおいて再度お試しください。
          </p>
        )
      }
    </section>
  </div>
</BaseLayout>

{
  formrun.enabled && (
    <script
      is:inline
      src={formrun.embedScriptUrl}
      onerror="document.getElementById('formrun-load-error').hidden = false;"
    />
  )
}

<style>
  .plain-list {
    padding-left: 1.25em;
  }

  .plain-list li {
    margin-bottom: 0.5em;
  }

  .quiet-links {
    font-size: 0.9375rem;
  }

  .privacy-note {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-top: var(--space-s);
  }

  .formrun-wrap {
    max-width: var(--content-width);
    margin-top: var(--space-m);
  }

  /*
   * formrunのscriptは非同期に読み込まれ、実際のフォーム(iframe)は少し遅れて挿入される。
   * 高さの指定がないと、読み込み中(あるいは読み込みに失敗した場合)にこの領域が
   * 0pxに潰れ、フォームがない・壊れているように見えてしまうため、
   * 最低限の高さと枠を仮の器として用意しておく(発見・修正した表示崩れ)。
   * formrunがiframeを挿入した後は、その高さがこのmin-heightを上回っても問題ない。
   */
  .formrun-embed {
    min-height: 420px;
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
  }

  .formrun-fallback {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    padding: var(--space-s);
    max-width: var(--content-width);
    margin-top: var(--space-m);
  }
</style>
