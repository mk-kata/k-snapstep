---
// お問い合わせ
//
// 出典: docs/KSNAPSTEP_SITE_SPEC.md 15番のとおり、docs/MARORIRI_SITE_SPEC.md 15-7
// (1672〜1823行目、全7セクション+フォーム項目一覧)を確認した。「お問い合わせの種類」の
// 選択肢のみをSITE_SPEC 15番の確定8択(マロリリコーダー部を除外し、Webサイト・CMSと
// 制作会社とのやり取りを2項目に分割した版)へ差し替え、他セクションは
// 「MARORIRIが」→「K-SNAPSTEPが」等のブランド名変更のみで使用している。
//
// formrunの本番埋め込みは今回まだ行わない(docs/KSNAPSTEP_SITE_SPEC.md 18番・今回の作業範囲外)。
// フィールド一覧は表示するが、送信は機能しない。formrun設置予定位置はHTMLコメントで示し、
// 一般利用者向けには「未完成」「構築中」等の表示をしていない。
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/navigation/Breadcrumbs.astro";
import PageHeader from "../../components/page/PageHeader.astro";
import StepList from "../../components/common/StepList.astro";
import { urls } from "../../config/site";

const consultItems = [
  "サイトを直すか作り直すか迷っている",
  "制作会社への頼み方や見積もりを確認したい",
  "CMSやサーバーの管理状況が分からない",
  "修正内容が意図どおり反映されているか確認したい",
  "継続してWebの判断や進行を確認してほしい",
  "K-SNAPSTEPで実作業に対応できるか確認したい",
];

const afterSteps = [
  { title: "フォームから送信", body: "フォームから、現在の状況をお送りください。" },
  { title: "内容確認", body: "K-SNAPSTEPが内容を確認します。" },
  { title: "追加確認(必要な場合)", body: "必要に応じて、追加の情報を確認します。" },
  { title: "ご案内", body: "適した相談方法や、進め方をご案内します。" },
];

const inquiryTypes = [
  "1日WEB担当者について",
  "月額Web担当サポートについて",
  "Webサイト・CMSについて",
  "制作会社とのやり取りについて",
  "サーバー・ドメイン・メールについて",
  "必要な実作業について",
  "どれを選べばよいか分からない",
  "その他",
];
---

<BaseLayout
  title="お問い合わせ"
  description="まとまっていなくても、今の状況をお送りください。サービスを決めていなくても構いません。内容を確認し、K-SNAPSTEPから適した進め方をご案内します。"
  layoutType="page"
  showBuildNotice={false}
>
  <div class="container content-width">
    <Breadcrumbs items={[{ label: "トップ", href: "/" }, { label: "お問い合わせ" }]} />

    <PageHeader
      pageName="お問い合わせ"
      heading="まとまっていなくても、今の状況をお送りください。"
      intro="サービスを決めていなくても構いません。今のWebに関する状況や、困っていることを分かる範囲でお送りください。内容を確認し、K-SNAPSTEPから適した進め方をご案内します。お問い合わせのみで契約が成立することはありません。"
      ctaLabel="お問い合わせ内容を入力する"
      ctaHref="#form"
    />

    <section class="section-block">
      <h2>このような内容をご相談いただけます。</h2>
      <ul class="plain-list">
        {consultItems.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="section-block">
      <h2>サービスを決めていなくても構いません。</h2>
      <p>
        一つの課題を集中して整理する場合は、1日WEB担当者が合います。継続してWebの判断や進行を確認する場合は、月額Web担当サポートが合います。実作業が必要な場合は、内容を確認したうえで個別にお見積もりします。
      </p>
      <p>
        どれが合うか分からなくても、ご自身でサービスを決めてからお問い合わせいただく必要はありません。お送りいただいた内容を確認したうえで、進め方をご案内します。
      </p>
      <p class="quiet-links">
        <a href={urls.oneDayWebManager}>1日WEB担当者</a> ／
        <a href={urls.monthlySupport}>月額Web担当サポート</a> ／
        <a href={urls.services}>対応できること</a>
      </p>
    </section>

    <section class="section-block">
      <h2>お問い合わせ後の流れ。</h2>
      <StepList steps={afterSteps} />
    </section>

    <section class="section-block">
      <h2>フォームに入力していただく内容。</h2>
      <p>
        お名前、メールアドレス、お問い合わせの種類、現在困っていることをご記入ください。会社名・屋号は任意ですので、個人でご相談の場合は空欄で構いません。
      </p>
      <p>
        対象サイトのURL、使用中のCMS・ECサービス、制作会社の有無、希望する対応時期は、分かる範囲でご記入ください。URLやCMSが分からない場合も、空欄のままで大丈夫です。
      </p>
    </section>

    <section class="section-block">
      <h2>オンラインと訪問について。</h2>
      <p>
        ご相談は、基本的にオンラインで行います。内容や地域によっては、訪問での対応も可能です。訪問をご希望の場合は、フォームの「オンライン・訪問の希望」でお知らせください。
      </p>
    </section>

    <section id="form" class="section-block">
      <h2>現在の状況をお送りください。</h2>
      <p>
        すべてを整理して書く必要はありません。現在困っていることを、分かる範囲でご記入ください。サイトのURLや使用中のCMSなど、任意の項目は、分からなければ空欄で構いません。内容を確認したうえで、進め方をご案内します。
      </p>

      <!-- formrun埋め込み予定位置。本番接続時は下記フィールドをformrunの埋め込みスクリプト(data-formrun-form属性)へ置き換える。今回は本番接続を行わない。 -->
      <form class="contact-form" data-formrun-pending="true">
        <div class="contact-form__field">
          <label for="name">お名前<span class="required-badge">必須</span></label>
          <input type="text" id="name" name="name" />
        </div>

        <div class="contact-form__field">
          <label for="company">会社名・屋号<span class="optional-badge">任意</span></label>
          <input type="text" id="company" name="company" />
        </div>

        <div class="contact-form__field">
          <label for="email">メールアドレス<span class="required-badge">必須</span></label>
          <input type="email" id="email" name="email" />
        </div>

        <div class="contact-form__field">
          <label for="inquiry-type">お問い合わせの種類<span class="required-badge">必須</span></label>
          <select id="inquiry-type" name="inquiry-type">
            {inquiryTypes.map((type) => <option>{type}</option>)}
          </select>
        </div>

        <div class="contact-form__field">
          <label for="site-url">対象サイトのURL<span class="optional-badge">任意</span></label>
          <input type="text" id="site-url" name="site-url" />
        </div>

        <div class="contact-form__field">
          <label for="cms">使用中のCMS・ECサービス<span class="optional-badge">任意</span></label>
          <input type="text" id="cms" name="cms" />
        </div>

        <div class="contact-form__field">
          <label for="production-partner">制作会社の有無<span class="optional-badge">任意</span></label>
          <select id="production-partner" name="production-partner">
            <option>依頼中の制作会社がある</option>
            <option>現在はない</option>
            <option>分からない</option>
          </select>
        </div>

        <div class="contact-form__field">
          <label for="timing">希望する対応時期<span class="optional-badge">任意</span></label>
          <input
            type="text"
            id="timing"
            name="timing"
            placeholder="例：〇月ごろまでに相談したい／時期は決まっていない"
          />
        </div>

        <div class="contact-form__field">
          <label for="visit">オンライン・訪問の希望<span class="optional-badge">任意</span></label>
          <select id="visit" name="visit">
            <option>オンラインを希望</option>
            <option>訪問を希望</option>
            <option>相談して決めたい</option>
          </select>
          <p class="contact-form__hint">訪問は内容や地域により対応可否を確認します。</p>
        </div>

        <div class="contact-form__field">
          <label for="details">現在困っていること<span class="required-badge">必須</span></label>
          <textarea id="details" name="details" rows="6"></textarea>
        </div>

        <div class="contact-form__field contact-form__field--checkbox">
          <label>
            <input type="checkbox" id="privacy-agree" name="privacy-agree" />
            <a href={urls.privacy}>個人情報の取り扱いについて</a>確認し、同意します<span class="required-badge">必須</span>
          </label>
        </div>

        <p class="contact-form__note">
          お問い合わせのみで契約が成立することはありません。営業・勧誘を目的としたご連絡には、返信できない場合があります。個人情報の取り扱いについて確認し、同意のうえ送信してください。
        </p>

        <button type="submit" class="btn-primary">この内容で送信する</button>
      </form>
    </section>
  </div>
</BaseLayout>

<style>
  .section-block {
    padding-block: var(--space-m);
    border-top: 1px solid var(--color-border);
  }

  .section-block h2 {
    margin-top: 0;
  }

  .plain-list {
    padding-left: 1.25em;
  }

  .plain-list li {
    margin-bottom: 0.5em;
  }

  .quiet-links {
    font-size: 0.9375rem;
  }

  .contact-form {
    max-width: var(--content-width);
    margin-top: var(--space-m);
  }

  .contact-form__field {
    margin-bottom: var(--space-m);
  }

  .contact-form__field label {
    display: block;
    font-weight: 700;
    margin-bottom: 0.4em;
  }

  .contact-form__field input[type="text"],
  .contact-form__field input[type="email"],
  .contact-form__field select,
  .contact-form__field textarea {
    width: 100%;
    padding: 0.6em;
    border: 1px solid var(--color-border);
    font: inherit;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .contact-form__field--checkbox label {
    display: flex;
    align-items: flex-start;
    gap: 0.5em;
    font-weight: 400;
  }

  .contact-form__field--checkbox input {
    margin-top: 0.3em;
    min-width: var(--tap-target-min);
    min-height: 1.25em;
  }

  .contact-form__hint {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin: 0.4em 0 0;
  }

  .contact-form__note {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-s);
  }

  .required-badge,
  .optional-badge {
    font-size: 0.6875rem;
    font-weight: 700;
    margin-inline-start: 0.5em;
    padding: 0.1em 0.5em;
    border: 1px solid var(--color-border);
  }

  .required-badge {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .optional-badge {
    color: var(--color-text-muted);
  }
</style>
