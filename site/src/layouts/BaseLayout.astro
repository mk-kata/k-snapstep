---
// K-SNAPSTEP 共通レイアウト
//
// 役割: <!doctype html>・<html lang="ja">・<head>(title/description/canonical/OGP/Twitter Card/favicon)・
// skip link・共通ヘッダー・<main id="main-content">・共通フッターを提供する。
//
// 今回まだ実装しないもの(docs/KSNAPSTEP_IMPLEMENTATION_GAP.md 25番「基盤」の一部):
// - GTM(GTM-TXFRNQ3)の設置
// - formrunの設置
// - JSON-LDの実装(既存の「本来面目らぼ」名義JSON-LDは移植しない)
//
// OGP画像・本番URLは仮の値。正式ロゴ・ドメイン運用方針確定後に差し替える。

import SiteHeader from "../components/global/SiteHeader.astro";
import SiteFooter from "../components/global/SiteFooter.astro";
import GtmHead from "../components/global/GtmHead.astro";
import GtmBody from "../components/global/GtmBody.astro";
import OrganizationJsonLd from "../components/seo/OrganizationJsonLd.astro";
import { site, shouldIndex } from "../config/site";
// src/styles/ 配下のCSSはViteのimportで読み込む(public/配下に置いて直接<link>する方式は取らない)。
// これにより、Astroが自動でハッシュ付きファイル名を発行し、正しくdistへ出力・参照される。
import "../styles/tokens.css";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  ogType?: string;
  ogImage?: string;
  bodyClass?: string;
  /** ページの種類を表す任意のラベル(例: "page" | "home" | "article")。body要素にクラスとして付与する */
  layoutType?: string;
  /**
   * 「Astro基盤の動作確認用の仮ページです」という表示の有無。
   * トップページは確定9セクションを実装済みのため false にする
   * (docs/KSNAPSTEP_HOME_IMPLEMENTATION.md 参照)。下層ページはまだ仮本文のため既定でtrueのまま。
   */
  showBuildNotice?: boolean;
}

const {
  title,
  description,
  canonical,
  noindex = false,
  ogType = "website",
  ogImage,
  bodyClass = "",
  layoutType = "page",
  showBuildNotice = true,
} = Astro.props;

const canonicalUrl = new URL(canonical ?? Astro.url.pathname, site.url).toString();
const pageTitle = title === site.name ? site.defaultTitle : `${title} ｜ ${site.name}`;
const bodyClasses = [`layout-${layoutType}`, bodyClass].filter(Boolean).join(" ");
// production以外(staging・development)は、ページ個別のnoindex指定に関わらず常にnoindexにする
// (docs/KSNAPSTEP_LAUNCH_FOUNDATION.md 16・20番、公開事故防止のための既定値)。
const effectiveNoindex = noindex || !shouldIndex;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <GtmHead />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {effectiveNoindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- OGP(OGP画像は正式なもの未作成のため今回は出力しない。KSNAPSTEP_LAUNCH_FOUNDATION.md 13番参照) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, site.url).toString()} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={new URL(ogImage, site.url).toString()} />}

    <!-- favicon(仮参照。正式ロゴ確定後に差し替え) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- サイト共通JSON-LD(ProfessionalService+WebSite)。ページ固有のJSON-LDは各ページで追加する -->
    <OrganizationJsonLd />
  </head>
  <body class={bodyClasses}>
    <GtmBody />
    <a class="skip-link" href="#main-content">本文へ移動</a>

    {
      showBuildNotice && (
        <p class="build-notice">
          この画面はAstro基盤の動作確認用の仮ページです。本番用の完成ページではありません。
        </p>
      )
    }

    <SiteHeader />

    <main id="main-content">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
