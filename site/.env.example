# K-SNAPSTEP 環境変数サンプル
#
# 参照元: docs/KSNAPSTEP_LAUNCH_FOUNDATION.md 16・22番。
# ここに実際の秘密情報は含まれていない(GTM IDも秘密情報ではないが、直書き箇所を1箇所にまとめる目的)。
# 実際に使う場合は、このファイルをコピーして `.env`(または `.env.production` 等)を作成し、
# 値を必要に応じて変更する。`.env`・`.env.production` は .gitignore 済みでコミットされない。
#
# すべて PUBLIC_ 接頭辞(Astroの仕様により、クライアント側にも公開される値であることを示す)。
# 値を増やしすぎないよう、今回は次の5つのみを扱う。

# 本番/ステージングのURL。未設定時は本番候補URル(https://k-snapstep.com)を使用する。
PUBLIC_SITE_URL=https://k-snapstep.com

# "production" | "staging" のいずれか。未設定時は開発扱い(development)となり、
# 常にnoindex・robots全体拒否になる(公開事故防止のための既定値)。
# 本番ビルド時のみ "production" を設定する。
PUBLIC_SITE_ENV=production

# GTMコンテナID。未設定時は既存の GTM-TXFRNQ3 を使用する。
PUBLIC_GTM_ID=GTM-TXFRNQ3

# "true" のときのみGTMを出力する。未設定・それ以外の値のときは常に無効(開発環境での誤計測防止)。
PUBLIC_ENABLE_GTM=false

# "false" のときのみformrunの実際の埋め込みを無効化し、代替表示にする。未設定時は有効。
PUBLIC_ENABLE_FORM=true
